# Yalnızca yerel geliştirme. Yayında güçlü ve farklı parolalar kullanın.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mavi_otel
DB_USER=otel
DB_PASSWORD=local-otel-password
# Unix soketi kullanılıyorsa mutlak yol yazılabilir.
DB_SOCKET=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=5000
MYSQL_ROOT_PASSWORD=local-root-password


# Rezervasyon onay e-postası (isteğe bağlı). SMTP_HOST boşsa e-postalar
# .local/mail klasörüne .eml dosyası olarak yazılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=Mavi Otel <rezervasyon@mavi-otel.test>
